/target/
# Local runtime data must not enter source or image build contexts.
/data/
# Local deployment configuration and generated secret paths. These are
# machine-specific and must never become repository defaults.
/deploy/compose/.env
/deploy/compose/.env.local
/deploy/compose/runtime/
/deploy/compose/secrets/
/deploy/compose/backups/

node_modules/
.pnpm-store/
dist/
# The console's Node-side test output (CNSL-1): the pure modules compiled
# for `node --test`, separate from the Vite bundle in dist/.
dist-test/
*.tsbuildinfo
.DS_Store
Thumbs.db

# Local Codex recovery state. Durable project state belongs in STATUS/open
# briefs; the Docker build exclusion is a separate `.dockerignore` contract.
/.codex/
