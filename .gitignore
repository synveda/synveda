/target/
# The gateway's Tantivy sidecar (CTX-1): SYNVEDA_SEARCH_INDEX_DIR defaults
# here, so running the binary or a demo from the repo root materialises a
# per-tenant index. Derived data, rebuilt by the indexer's sweep.
/data/
# Written by `synveda init` (OPS-1): this deployment's tenant id, issuer and
# embedder. Generated, per-machine, and regenerated by re-running init —
# committing it would hand every checkout one laptop's tenant.
/deploy/compose/.env

