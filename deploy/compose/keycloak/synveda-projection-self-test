# Deterministic adversarial checks for the content-free Keycloak projection
# boundary. This runs while the optimized image is built and ships no fixture.
unset BASH_ENV ENV CDPATH GLOBIGNORE PS4
set +x
set -eu
umask 077

test_dir=$(mktemp -d /tmp/synveda-keycloak-projection-test.XXXXXX)
test_name=setup
cleanup() {
    status=$?
    if [ "$status" -ne 0 ]; then
        echo "Keycloak projection self-test failed at $test_name" >&2
    fi
    rm -f -- "$test_dir"/*
    rmdir -- "$test_dir"
    exit "$status"
}
trap cleanup EXIT HUP INT TERM

run_projection() {
    /usr/bin/timeout --foreground --signal=TERM --kill-after=1s 5s \
        /usr/bin/java -cp '/opt/keycloak/bin:/opt/keycloak/lib/lib/main/*' \
        SynvedaKeycloakProjection "$@"
}

accept() {
    expected=$1
    shift
    run_projection "$@" > "$test_dir/output" 2> "$test_dir/error"
    [ ! -s "$test_dir/error" ]
    actual=
    if [ -s "$test_dir/output" ]; then
        actual=$(cat "$test_dir/output")
    fi
    [ "$actual" = "$expected" ]
}

refuse() {
    if run_projection "$@" > "$test_dir/output" 2> "$test_dir/error"; then
        return 1
    fi
    [ ! -s "$test_dir/output" ]
    [ "$(cat "$test_dir/error")" = "keycloak-projection: input was refused" ]
}

