https://{$SYNVEDA_APP_HOST} {
	tls /run/secrets/tls_cert /run/secrets/tls_key
	import synveda_response_headers
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	request_body {
		max_size 16MB
	}
	handle /metrics {
		respond 404
	}
	handle {
		reverse_proxy gateway:8120 {
			import synveda_upstream
		}
	}
}
