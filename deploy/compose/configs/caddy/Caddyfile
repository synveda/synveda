{
	admin off
	http_port {$SYNVEDA_PROXY_HTTP_PORT}
	https_port {$SYNVEDA_PROXY_HTTPS_PORT}
	servers {
		max_header_size 32KB
		timeouts {
			read_body 30s
			read_header 10s
			write 60s
			idle 2m
		}
	}
}

(synveda_response_headers) {
	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
}

# Removed on arrival, not upstream: Caddy applies header_up deletions after
# its sets, which would also drop the forwarding headers set below.
(synveda_client_headers) {
	request_header -Forwarded
	request_header -X-Forwarded-*
	request_header -X-Real-IP
	request_header -X-Original-*
	request_header -X-Remote-User
	request_header -X-Authenticated-User
	request_header -X-User
	request_header -Remote-User
	request_header -traceparent
	request_header -tracestate
	request_header -baggage
	request_header -b3
	request_header -X-B3-*
	request_header -uber-trace-id
	request_header -ot-tracer-*
}

(synveda_upstream) {
	header_up X-Forwarded-For {remote_host}
	header_up X-Forwarded-Host {host}
	header_up X-Forwarded-Proto {scheme}
	header_up X-Forwarded-Port {$SYNVEDA_PUBLIC_PORT}
	transport http {
		dial_timeout 5s
		response_header_timeout 30s
		keepalive_idle_conns_per_host 32
	}
}

import /etc/caddy/app.caddy
import /etc/caddy/identity.caddy
