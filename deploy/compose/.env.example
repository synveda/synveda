# CPR-45 canonical Compose selectors. This file contains no credential, key,
# token, confidential DSN or usable demo identity.
SYNVEDA_COMPOSE_RUNTIME=development
SYNVEDA_POSTGRES_MODE=bundled
SYNVEDA_OIDC_MODE=bundled
SYNVEDA_COMPOSE_PROFILES=

SYNVEDA_APP_HOST=app.synveda.test
# Bundled OIDC only. External OIDC retains the provider's issuer hostname.
SYNVEDA_AUTH_HOST=auth.synveda.test
SYNVEDA_PUBLIC_SCHEME=http
SYNVEDA_DEV_HTTP_PORT=8080
# Required only for external OIDC. Exact matching against the mounted issuer
# configuration is enforced by the product diagnostic in the runnable slice.
SYNVEDA_OIDC_ISSUER=
# Reference currently accepts certificate-file mode only; ACME is unimplemented.
SYNVEDA_TLS_MODE=files

SYNVEDA_RUNTIME_UID=65532
SYNVEDA_RUNTIME_GID=65532
# Development convenience only. Reference and acceptance-suffixed projects
# must explicitly select and preflight a distinct canonical private /24.
SYNVEDA_COMPOSE_IPV4_POOL=172.30.240.0/24

SYNVEDA_PRODUCT_IMAGE=synveda/product:dev
SYNVEDA_POSTGRES_IMAGE=synveda/postgres:17.11-dev
SYNVEDA_KEYCLOAK_IMAGE=synveda/keycloak:26.7.2-dev
SYNVEDA_CADDY_IMAGE=synveda/proxy:2.11.4-dev
SYNVEDA_OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.159.0@sha256:1f2c54a30e713fac6b3ae77a1ec84010c2007e29ced8ec666214fc2f6739c1cc

SYNVEDA_SECRETS_DIR=./secrets
# The selector and generator derive project-scoped database-authority and
# Keycloak public-gate directories under ./runtime. An override must retain
# the /synveda-<runtime>[-acceptance-<suffix>]/<state-name> suffix.
# External PostgreSQL requires an explicit topology-specific role contract.
# Bundled modes select the matching checked-in contract automatically.
# SYNVEDA_DATABASE_ROLES_FILE=./configs/database/roles.reference.json
SYNVEDA_OIDC_ISSUERS_FILE=./runtime/issuers.json
RUST_LOG=info
