#!/bin/sh
# CPR-45 / ADR-0102: one product image exposes a closed command vocabulary.
# Deployment shape belongs in Compose or Helm, never in this launcher.
set -eu

usage() {
    echo "usage: synveda-container {gateway|worker|database-preflight|migrate|probe {gateway|worker} {live|ready}}" >&2
    exit 64
}

case "${1:-}" in
    gateway)
        [ "$#" -eq 1 ] || usage
        exec /usr/local/bin/synveda-gateway
        ;;
    worker)
        [ "$#" -eq 1 ] || usage
        exec /usr/local/bin/synveda-worker
        ;;
    database-preflight)
        [ "$#" -eq 1 ] || usage
        exec /usr/local/bin/synveda db preflight
        ;;
    migrate)
        [ "$#" -eq 1 ] || usage
        exec /usr/local/bin/synveda db migrate
        ;;
    probe)
        [ "$#" -eq 3 ] || usage
        case "$2" in
            gateway) port=8120 ;;
            worker) port=8121 ;;
            *) usage ;;
        esac
        case "$3" in
            live) path=healthz ;;
            ready) path=readyz ;;
            *) usage ;;
        esac
        exec /usr/bin/curl \
            --disable \
            --noproxy '*' \
            --fail \
            --silent \
            --show-error \
            --connect-timeout 1 \
            --max-time 2 \
            "http://127.0.0.1:${port}/${path}"
        ;;
    *)
        usage
        ;;
esac
