#!/bin/sh
# CPR-45 / ADR-0102: converge one fixed deployment database and its roles.
# Passwords arrive only through mounted files. Runtime-role passwords enter
# PostgreSQL through COPY data and are consumed by fixed, exception-sanitised
# server code; neither plaintext nor verifiers are part of a logged statement.
set -eu
# Never inherit caller tracing into path validation or secret-file reads.
set +x

LC_ALL=C
export LC_ALL
umask 077

usage() {
    echo "usage: synveda-database-bootstrap {synveda|keycloak}" >&2
    exit 64
}

file_size() {
    stat -c %s "$1" 2>/dev/null || stat -Lf %z "$1" 2>/dev/null
}

file_mode() {
    stat -c %a "$1" 2>/dev/null || stat -f %Lp "$1" 2>/dev/null
}

file_owner() {
    stat -c %u "$1" 2>/dev/null || stat -f %u "$1" 2>/dev/null
}

[ "$#" -eq 1 ] || usage
case "$1" in
    synveda|keycloak) target=$1 ;;
    validate-synveda-passwords|validate-keycloak-password) target=$1 ;;
    *) usage ;;
esac

# Every mounted input is opened once and copied through one 4097-byte read into
# a process-private tmpfs directory. Validators and psql consume only those
# immutable-by-convention snapshots, so a mutable bind cannot turn a bounded
# preflight into an unbounded later read or change bytes between validation and
# COPY. The fixed path is required because psql deliberately does not expand
# variables in \copy arguments.
snapshot_dir=/tmp/synveda-database-bootstrap
snapshot_dir_owned=false
bootstrap_pgpass=
witness_dir=
witness_temp=
snapshot_temp=

cleanup_private_files() {
    if [ -n "$bootstrap_pgpass" ]; then
        rm -f "$bootstrap_pgpass"
    fi
    if [ -n "$witness_temp" ]; then
        rm -f "$witness_temp"
        sync "$witness_dir" 2>/dev/null || :
    fi
    if [ -n "$snapshot_temp" ]; then
        rm -f "$snapshot_temp"
    fi
    if [ "$snapshot_dir_owned" = true ]; then
        rm -f \
            "$snapshot_dir/database_roles.json" \
            "$snapshot_dir/postgres_bootstrap_password" \
            "$snapshot_dir/synveda_migrator_password" \
            "$snapshot_dir/synveda_gateway_password" \
            "$snapshot_dir/synveda_worker_password" \
            "$snapshot_dir/keycloak_database_password"
        rmdir "$snapshot_dir" 2>/dev/null || :
    fi
}
trap cleanup_private_files EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

case "$target" in
    synveda|keycloak)
        [ "${SYNVEDA_DATABASE_BOOTSTRAP_SHARED_SNAPSHOTS+x}" != x ] || {
            echo "database-bootstrap: internal snapshot setting is reserved" >&2
            exit 78
        }
        mkdir "$snapshot_dir" 2>/dev/null || {
            echo "database-bootstrap: private input snapshot directory is unavailable" >&2
            exit 70
        }
        chmod 700 "$snapshot_dir"
        snapshot_dir_owned=true
        SYNVEDA_DATABASE_BOOTSTRAP_SHARED_SNAPSHOTS=1
        export SYNVEDA_DATABASE_BOOTSTRAP_SHARED_SNAPSHOTS
        ;;
    validate-synveda-passwords|validate-keycloak-password)
        if [ "${SYNVEDA_DATABASE_BOOTSTRAP_SHARED_SNAPSHOTS:-}" = 1 ]; then
                [ ! -L "$snapshot_dir" ] && [ -d "$snapshot_dir" ] && \
                    [ "$(file_mode "$snapshot_dir")" = 700 ] && \
                    [ "$(file_owner "$snapshot_dir")" = "$(id -u)" ] || {
                echo "database-bootstrap: shared input snapshot directory was refused" >&2
                exit 78
            }
        else
            mkdir "$snapshot_dir" 2>/dev/null || {
                echo "database-bootstrap: private input snapshot directory is unavailable" >&2
                exit 70
            }
            chmod 700 "$snapshot_dir"
            snapshot_dir_owned=true
        fi
        ;;
esac

snapshot_input() {
    label=$1
    source=$2
    destination=$3
    temporary=$destination.tmp.$$
    snapshot_temp=$temporary
    rm -f "$temporary" "$destination"
    if ! command timeout --foreground --signal=TERM --kill-after=1s 5s \
        /usr/local/bin/synveda-input-snapshot "$source" "$temporary" \
        >/dev/null 2>&1; then
        rm -f "$temporary"
        echo "database-bootstrap: $label could not be snapshotted safely" >&2
        exit 78
    fi
    [ ! -L "$temporary" ] && [ -f "$temporary" ] && \
        [ "$(file_mode "$temporary")" = 600 ] && \
        [ "$(file_owner "$temporary")" = "$(id -u)" ] || {
        rm -f "$temporary"
        echo "database-bootstrap: $label snapshot metadata was refused" >&2
        exit 78
    }
    bytes=$(file_size "$temporary") || {
        rm -f "$temporary"
        echo "database-bootstrap: $label size cannot be inspected" >&2
        exit 78
    }
    case "$bytes" in
        ''|*[!0-9]*)
            rm -f "$temporary"
            echo "database-bootstrap: $label size cannot be inspected" >&2
            exit 78
            ;;
    esac
    [ "$bytes" -le 4096 ] || {
        rm -f "$temporary"
        echo "database-bootstrap: $label exceeds 4096 bytes" >&2
        exit 78
    }
    mv "$temporary" "$destination"
    snapshot_temp=
}

read_secret() {
    label=$1
    path=$2
    [ ! -L "$path" ] && [ -f "$path" ] || {
        echo "database-bootstrap: $label must be a regular non-symlink file" >&2
        exit 78
    }
    bytes=$(file_size "$path") || {
        echo "database-bootstrap: $label size cannot be inspected" >&2
        exit 78
    }
    case "$bytes" in
        ''|*[!0-9]*)
            echo "database-bootstrap: $label size cannot be inspected" >&2
            exit 78
            ;;
    esac
    [ "$bytes" -le 4096 ] || {
        echo "database-bootstrap: $label exceeds 4096 bytes" >&2
        exit 78
    }
    without_nul=$(tr -d '\000' < "$path" | wc -c)
    [ "$bytes" -eq "$without_nul" ] || {
        echo "database-bootstrap: $label contains a NUL byte" >&2
        exit 78
    }
    newlines=$(tr -cd '\n' < "$path" | wc -c | tr -d ' ')
    case "$newlines" in
        0) ;;
        1)
            last_byte=$(tail -c 1 "$path" | od -An -tu1 | tr -d ' ')
            [ "$last_byte" = 10 ] || {
                echo "database-bootstrap: $label must contain one line" >&2
                exit 78
            }
            ;;
        *)
            echo "database-bootstrap: $label must contain one line" >&2
            exit 78
            ;;
    esac
    value=
    IFS= read -r value < "$path" || :
    case "$value" in
        *"$(printf '\r')") value=${value%"$(printf '\r')"} ;;
    esac
    [ -n "$value" ] || {
        echo "database-bootstrap: $label must not be empty" >&2
        exit 78
    }
    printf '%s' "$value"
}

validate_role_password_content() {
    label=$1
    path=$2
    value=$(read_secret "$label" "$path")
    case "$value" in
        SCRAM-SHA-256\$*)
            echo "database-bootstrap: $label must be plaintext, not a PostgreSQL verifier" >&2
            exit 78
            ;;
    esac
    case "$value" in
        md5*)
            verifier=${value#md5}
            case "$verifier" in
                *[!0-9A-Fa-f]*) ;;
                *)
                    if [ "${#verifier}" -eq 32 ]; then
                        echo "database-bootstrap: $label must be plaintext, not a PostgreSQL verifier" >&2
                        exit 78
                    fi
                    ;;
            esac
            ;;
    esac
    case "$value" in
        *[!A-Za-z0-9._~-]*)
            echo "database-bootstrap: $label contains unsupported bytes" >&2
            exit 78
            ;;
    esac
}

snapshot_bootstrap_password_for_validator() {
    if [ "${SYNVEDA_DATABASE_BOOTSTRAP_SHARED_SNAPSHOTS:-}" != 1 ]; then
        snapshot_input postgres_bootstrap_password /run/secrets/postgres_bootstrap_password \
            "$snapshot_dir/postgres_bootstrap_password"
    fi
    # Validate the owner snapshot without retaining its value in this shell.
    (read_secret postgres_bootstrap_password \
        "$snapshot_dir/postgres_bootstrap_password") >/dev/null
}

validate_distinct_credentials() {
    while [ "$#" -gt 1 ]; do
        first=$1
        shift
        first_value=$(read_secret database_credential "$first")
        for candidate do
            candidate_value=$(read_secret database_credential "$candidate")
            if [ "$first_value" = "$candidate_value" ]; then
                echo "database-bootstrap: database credentials must be pairwise distinct" >&2
                exit 78
            fi
            unset candidate_value
        done
        unset first_value
    done
}

validate_role_contract_file() {
    path=$1
    [ ! -L "$path" ] && [ -f "$path" ] && [ -r "$path" ] || {
        echo "database-bootstrap: database role contract must be a readable regular non-symlink file" >&2
        exit 78
    }
    bytes=$(file_size "$path") || {
        echo "database-bootstrap: database role contract size cannot be inspected" >&2
        exit 78
    }
    case "$bytes" in
        ''|*[!0-9]*)
            echo "database-bootstrap: database role contract size cannot be inspected" >&2
            exit 78
            ;;
    esac
    [ "$bytes" -gt 0 ] && [ "$bytes" -le 4096 ] || {
        echo "database-bootstrap: database role contract must contain 1 through 4096 bytes" >&2
        exit 78
    }
    without_nul=$(tr -d '\000' < "$path" | wc -c)
    [ "$bytes" -eq "$without_nul" ] || {
        echo "database-bootstrap: database role contract contains a NUL byte" >&2
        exit 78
    }
    newlines=$(tr -cd '\n' < "$path" | wc -c | tr -d ' ')
    [ "$newlines" -eq 1 ] && [ "$(tail -c 1 "$path" | od -An -tu1 | tr -d ' ')" = 10 ] || {
        echo "database-bootstrap: database role contract must be one newline-terminated JSON line" >&2
        exit 78
    }
}

# Password bytes are deliberately read only by a subprocess invoked from the
# locked PostgreSQL preflight, after every non-secret cluster refusal and just
# before its persistent mutation boundary. The target transaction repeats the
# same validation in SQL after COPY as defence against a changed mount.
case "$target" in
    validate-synveda-passwords)
        require_keycloak_password=${SYNVEDA_DATABASE_REQUIRE_KEYCLOAK_PASSWORD:-false}
        case "$require_keycloak_password" in
            true|false) ;;
            *)
                echo "database-bootstrap: SYNVEDA_DATABASE_REQUIRE_KEYCLOAK_PASSWORD must be true or false" >&2
                exit 78
                ;;
        esac
        snapshot_bootstrap_password_for_validator
        snapshot_input synveda_migrator_password /run/secrets/synveda_migrator_password \
            "$snapshot_dir/synveda_migrator_password"
        snapshot_input synveda_gateway_password /run/secrets/synveda_gateway_password \
            "$snapshot_dir/synveda_gateway_password"
        snapshot_input synveda_worker_password /run/secrets/synveda_worker_password \
            "$snapshot_dir/synveda_worker_password"
        validate_role_password_content synveda_migrator_password \
            "$snapshot_dir/synveda_migrator_password"
        validate_role_password_content synveda_gateway_password \
            "$snapshot_dir/synveda_gateway_password"
        validate_role_password_content synveda_worker_password \
            "$snapshot_dir/synveda_worker_password"
        if [ "$require_keycloak_password" = true ]; then
            snapshot_input keycloak_database_password /run/secrets/keycloak_database_password \
                "$snapshot_dir/keycloak_database_password"
            validate_role_password_content keycloak_database_password \
                "$snapshot_dir/keycloak_database_password"
            validate_distinct_credentials \
                "$snapshot_dir/postgres_bootstrap_password" \
                "$snapshot_dir/synveda_migrator_password" \
                "$snapshot_dir/synveda_gateway_password" \
                "$snapshot_dir/synveda_worker_password" \
                "$snapshot_dir/keycloak_database_password"
        else
            validate_distinct_credentials \
                "$snapshot_dir/postgres_bootstrap_password" \
                "$snapshot_dir/synveda_migrator_password" \
                "$snapshot_dir/synveda_gateway_password" \
                "$snapshot_dir/synveda_worker_password"
        fi
        exit 0
        ;;
    validate-keycloak-password)
        snapshot_bootstrap_password_for_validator
        snapshot_input keycloak_database_password /run/secrets/keycloak_database_password \
            "$snapshot_dir/keycloak_database_password"
        validate_role_password_content keycloak_database_password \
            "$snapshot_dir/keycloak_database_password"
        validate_distinct_credentials \
            "$snapshot_dir/postgres_bootstrap_password" \
            "$snapshot_dir/keycloak_database_password"
        exit 0
        ;;
esac

bundled_cluster=${SYNVEDA_POSTGRES_BUNDLED_CLUSTER:-false}
case "$bundled_cluster" in
    true) ;;
    false)
        echo "database-bootstrap: external PostgreSQL mutation is unavailable until the authenticated TLS bootstrap contract is implemented" >&2
        exit 78
        ;;
    *)
        echo "database-bootstrap: SYNVEDA_POSTGRES_BUNDLED_CLUSTER must be true or false" >&2
        exit 78
        ;;
esac
export SYNVEDA_POSTGRES_BUNDLED_CLUSTER=$bundled_cluster

role_contract_file=${SYNVEDA_DATABASE_ROLES_FILE:-}
[ "$role_contract_file" = /run/secrets/database_roles.json ] || {
    echo "database-bootstrap: SYNVEDA_DATABASE_ROLES_FILE must name the fixed mounted contract path" >&2
    exit 78
}
snapshot_input "database role contract" "$role_contract_file" \
    "$snapshot_dir/database_roles.json"
role_contract_file=$snapshot_dir/database_roles.json
validate_role_contract_file "$role_contract_file"

witness_dir=
witness_file=
witness_temp=
if [ "$target" = keycloak ]; then
    witness_dir=${SYNVEDA_DATABASE_AUTHORITY_DIR:-}
    case "$witness_dir" in
        /*) ;;
        *)
            echo "database-bootstrap: database authority directory must be absolute" >&2
            exit 78
            ;;
    esac
    [ ! -L "$witness_dir" ] && [ -d "$witness_dir" ] && [ -w "$witness_dir" ] || {
        echo "database-bootstrap: database authority directory is unavailable" >&2
        exit 78
    }
    [ "$(file_mode "$witness_dir")" = 700 ] && \
        [ "$(file_owner "$witness_dir")" = "$(id -u)" ] || {
        echo "database-bootstrap: database authority directory must be private and process-owned" >&2
        exit 78
    }
    witness_file=$witness_dir/keycloak-cluster.json
    if [ -e "$witness_file" ] || [ -L "$witness_file" ]; then
        [ ! -L "$witness_file" ] && [ -f "$witness_file" ] && \
            [ "$(file_mode "$witness_file")" = 600 ] && \
            [ "$(file_owner "$witness_file")" = "$(id -u)" ] || {
            echo "database-bootstrap: existing database authority witness was refused" >&2
            exit 78
        }
        rm -f "$witness_file"
        sync "$witness_dir"
    fi
fi

bootstrap_url=${SYNVEDA_POSTGRES_BOOTSTRAP_URL:-}
case "$bootstrap_url" in
    postgres://*|postgresql://*) ;;
    *)
        echo "database-bootstrap: SYNVEDA_POSTGRES_BOOTSTRAP_URL must be a PostgreSQL URL" >&2
        exit 78
        ;;
esac
case "$bootstrap_url" in
    *'?'*|*'#'*|*[![:print:]]*|*' '*)
        echo "database-bootstrap: bootstrap URL must contain no query, fragment or whitespace" >&2
        exit 78
        ;;
esac
location=${bootstrap_url#*://}
authority=${location%%/*}
database_name=${location#*/}
[ "$authority" != "$location" ] && [ -n "$database_name" ] && \
    [ "$database_name" = "${database_name##*/}" ] || {
    echo "database-bootstrap: bootstrap URL must identify one database" >&2
    exit 78
}
[ "${#database_name}" -le 63 ] || {
    echo "database-bootstrap: bootstrap URL database name is invalid" >&2
    exit 78
}
case "$database_name" in
    [A-Za-z0-9_]*) ;;
    *) echo "database-bootstrap: bootstrap URL database name is invalid" >&2; exit 78 ;;
esac
case "$database_name" in
    *[!A-Za-z0-9_-]*)
        echo "database-bootstrap: bootstrap URL database name is invalid" >&2
        exit 78
        ;;
esac
case "$authority" in
    *@*)
        bootstrap_user=${authority%%@*}
        endpoint=${authority#*@}
        ;;
    *)
        echo "database-bootstrap: bootstrap URL must name one login" >&2
        exit 78
        ;;
esac
[ -n "$bootstrap_user" ] && [ "${#bootstrap_user}" -le 63 ] || {
    echo "database-bootstrap: bootstrap URL login is invalid" >&2
    exit 78
}
case "$bootstrap_user" in
    *:*)
        echo "database-bootstrap: bootstrap URL must not contain a password" >&2
        exit 78
        ;;
    *[!A-Za-z0-9_-]*)
        echo "database-bootstrap: bootstrap URL login is invalid" >&2
        exit 78
        ;;
esac
case "$endpoint" in
    *@*|*:*:*)
        echo "database-bootstrap: bootstrap URL authority is invalid" >&2
        exit 78
        ;;
esac
bootstrap_host=${endpoint%:*}
bootstrap_port=${endpoint##*:}
[ "$bootstrap_host" != "$endpoint" ] && [ "${#bootstrap_host}" -le 253 ] || {
    echo "database-bootstrap: bootstrap URL endpoint is invalid" >&2
    exit 78
}
case "$bootstrap_host" in
    ''|*[!a-z0-9.-]*|.*|*.|*..*|localhost|*.localhost)
        echo "database-bootstrap: bootstrap URL endpoint is invalid" >&2
        exit 78
        ;;
    *[a-z]*) ;;
    *) echo "database-bootstrap: bootstrap URL endpoint is invalid" >&2; exit 78 ;;
esac
case "$bootstrap_port" in
    ''|0|0*|*[!0-9]*|??????*)
        echo "database-bootstrap: bootstrap URL endpoint is invalid" >&2
        exit 78
        ;;
esac
[ "$bootstrap_port" -le 65535 ] || {
    echo "database-bootstrap: bootstrap URL endpoint is invalid" >&2
    exit 78
}

case "$database_name" in
    synveda|keycloak)
        echo "database-bootstrap: bootstrap URL must identify a maintenance database" >&2
        exit 78
        ;;
esac
export SYNVEDA_POSTGRES_BOOTSTRAP_DATABASE=$database_name

if [ "${PGHOST+x}" = x ] || [ "${PGHOSTADDR+x}" = x ] || \
    [ "${PGPORT+x}" = x ] || [ "${PGDATABASE+x}" = x ] || \
    [ "${PGUSER+x}" = x ] || [ "${PGPASSWORD+x}" = x ] || \
    [ "${PGPASSFILE+x}" = x ] || [ "${PGSERVICE+x}" = x ] || \
    [ "${PGSERVICEFILE+x}" = x ] || [ "${PGOPTIONS+x}" = x ] || \
    [ "${PGAPPNAME+x}" = x ] || [ "${PGCONNECT_TIMEOUT+x}" = x ] || \
    [ "${PGCLIENTENCODING+x}" = x ] || [ "${PGDATESTYLE+x}" = x ] || \
    [ "${PGTZ+x}" = x ] || [ "${PGGEQO+x}" = x ] || \
    [ "${PGSSLMODE+x}" = x ] || [ "${PGREQUIRESSL+x}" = x ] || \
    [ "${PGSSLCOMPRESSION+x}" = x ] || [ "${PGSSLCERT+x}" = x ] || \
    [ "${PGSSLKEY+x}" = x ] || [ "${PGSSLROOTCERT+x}" = x ] || \
    [ "${PGSSLCRL+x}" = x ] || [ "${PGSSLCRLDIR+x}" = x ] || \
    [ "${PGSSLSNI+x}" = x ] || [ "${PGREQUIREPEER+x}" = x ] || \
    [ "${PGSSLMINPROTOCOLVERSION+x}" = x ] || \
    [ "${PGSSLMAXPROTOCOLVERSION+x}" = x ] || \
    [ "${PGSSLCERTMODE+x}" = x ] || [ "${PGSSLNEGOTIATION+x}" = x ] || \
    [ "${PGGSSLIB+x}" = x ] || [ "${PGGSSENCMODE+x}" = x ] || \
    [ "${PGGSSDELEGATION+x}" = x ] || \
    [ "${PGKRBSRVNAME+x}" = x ] || [ "${PGREALM+x}" = x ] || \
    [ "${PGCHANNELBINDING+x}" = x ] || \
    [ "${PGTARGETSESSIONATTRS+x}" = x ] || \
    [ "${PGLOADBALANCEHOSTS+x}" = x ] || [ "${PGREQUIREAUTH+x}" = x ] || \
    [ "${PGKEEPALIVES+x}" = x ] || [ "${PGTCPKEEPALIVESIDLE+x}" = x ] || \
    [ "${PGTCPKEEPALIVESINTERVAL+x}" = x ] || \
    [ "${PGTCPKEEPALIVESCOUNT+x}" = x ] || \
    [ "${PGTCPUSER_TIMEOUT+x}" = x ] || [ "${PGREPLICATION+x}" = x ] || \
    [ "${PGOAUTHCLIENTID+x}" = x ] || [ "${PGOAUTHCLIENTSECRET+x}" = x ] || \
    [ "${PGOAUTHISSUER+x}" = x ] || [ "${PGOAUTHSCOPE+x}" = x ] || \
    [ "${PGSYSCONFDIR+x}" = x ] || [ "${PGLOCALEDIR+x}" = x ] || \
    [ "${PSQLRC+x}" = x ]; then
    echo "database-bootstrap: ambient PostgreSQL connection settings are forbidden" >&2
    exit 78
fi
bootstrap_private_dir=${SYNVEDA_DATABASE_BOOTSTRAP_PRIVATE_DIR:-/tmp}
case "$bootstrap_private_dir" in
    /tmp|/run/secrets) ;;
    *)
        echo "database-bootstrap: SYNVEDA_DATABASE_BOOTSTRAP_PRIVATE_DIR is not an approved memory-backed path" >&2
        exit 78
        ;;
esac
[ ! -L "$bootstrap_private_dir" ] && [ -d "$bootstrap_private_dir" ] && [ -w "$bootstrap_private_dir" ] || {
    echo "database-bootstrap: the private PostgreSQL password directory is unavailable" >&2
    exit 78
}
snapshot_input postgres_bootstrap_password /run/secrets/postgres_bootstrap_password \
    "$snapshot_dir/postgres_bootstrap_password"
bootstrap_password=$(read_secret postgres_bootstrap_password \
    "$snapshot_dir/postgres_bootstrap_password")
bootstrap_pgpass=$(mktemp "$bootstrap_private_dir/synveda-bootstrap-pgpass.XXXXXX") || {
    echo "database-bootstrap: could not create the private PostgreSQL password file" >&2
    exit 70
}
{
    for pgpass_database in "$database_name" synveda keycloak; do
        printf '%s:%s:%s:%s:' \
            "$bootstrap_host" "$bootstrap_port" "$pgpass_database" "$bootstrap_user"
        printf '%s' "$bootstrap_password" | sed -e 's/\\/\\\\/g' -e 's/:/\\:/g'
        printf '\n'
    done
} > "$bootstrap_pgpass"
chmod 600 "$bootstrap_pgpass"
unset bootstrap_password
export PGPASSFILE=$bootstrap_pgpass
export PGCONNECT_TIMEOUT=5
export PGOPTIONS='-c search_path=pg_catalog -c role=none -c session_preload_libraries= -c local_preload_libraries= -c default_table_access_method=heap -c client_encoding=UTF8 -c jit=off -c lock_timeout=30000 -c statement_timeout=120000 -c idle_in_transaction_session_timeout=30000 -c client_min_messages=error'
export PSQLRC=/dev/null

publish_peer_witness() {
    witness_value=$1
    witness_bytes=$(printf '%s' "$witness_value" | wc -c | tr -d ' ')
    case "$witness_bytes" in
        ''|*[!0-9]*)
            echo "database-bootstrap: peer database witness was refused" >&2
            exit 1
            ;;
    esac
    [ "$witness_bytes" -gt 0 ] && [ "$witness_bytes" -lt 256 ] || {
        echo "database-bootstrap: peer database witness was refused" >&2
        exit 1
    }
    witness_newlines=$(printf '%s' "$witness_value" | tr -cd '\n' | wc -c | tr -d ' ')
    [ "$witness_newlines" = 0 ] || {
        echo "database-bootstrap: peer database witness was refused" >&2
        exit 1
    }
    case "$witness_value" in
        *"$(printf '\r')"*)
            echo "database-bootstrap: peer database witness was refused" >&2
            exit 1
            ;;
        '{"version":1,"database":"keycloak","cluster_system_identifier":"'*'","postmaster_started_at":"'*'Z","database_oid":'*'}') ;;
        *)
            echo "database-bootstrap: peer database witness was refused" >&2
            exit 1
            ;;
    esac
    witness_temp=$(mktemp "$witness_dir/.keycloak-cluster.XXXXXX") || {
        echo "database-bootstrap: peer database witness could not be staged" >&2
        exit 1
    }
    printf '%s\n' "$witness_value" > "$witness_temp"
    chmod 600 "$witness_temp"
    sync "$witness_temp"
    mv -f "$witness_temp" "$witness_file"
    witness_temp=
    sync "$witness_dir"
    unset witness_value
}

bootstrap_psql() {
    command timeout --foreground --signal=TERM --kill-after=5s 300s psql "$@"
}

bootstrap_psql_readiness() {
    command timeout --foreground --signal=TERM --kill-after=1s 6s psql "$@"
}

pin_existing_keycloak_database_oid() {
    bootstrap_psql --dbname="$bootstrap_url" -X -qAt -v ON_ERROR_STOP=1 <<'SQL'
\o /dev/null
\set VERBOSITY terse
\set SHOW_CONTEXT never
select pg_catalog.pg_advisory_lock(pg_catalog.hashtext('synveda.compose.bootstrap.cluster'));
