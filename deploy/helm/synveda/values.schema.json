                  "Exists",
                  "Equal"
                ]
              },
              "value": {
                "type": "string"
              },
              "effect": {
                "enum": [
                  "NoSchedule",
                  "PreferNoSchedule",
                  "NoExecute"
                ]
              },
              "tolerationSeconds": {
                "type": "integer"
              }
            },
            "required": []
          }
        },
        "affinity": {
          "type": "object"
        },
        "podAnnotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "databaseExistingSecret": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
        },
        "databaseUrlSecretKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "databasePasswordSecretKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "dbMaxConnections": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "shutdownSeconds": {
          "type": "integer",
          "minimum": 3,
          "maximum": 300
        },
        "logLevel": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "resources",
        "nodeSelector",
        "tolerations",
        "affinity",
        "podAnnotations",
        "databaseExistingSecret",
        "databaseUrlSecretKey",
        "databasePasswordSecretKey",
        "dbMaxConnections",
        "shutdownSeconds",
        "logLevel"
