            "caExistingSecret": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
            },
            "caSecretKey": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^[A-Za-z0-9._-]+$"
            },
            "roles": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "migrator": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 63,
                  "pattern": "^[A-Za-z0-9_@.-]+$"
                },
                "gateway": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 63,
                  "pattern": "^[A-Za-z0-9_@.-]+$"
                },
                "worker": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 63,
                  "pattern": "^[A-Za-z0-9_@.-]+$"
                },
                "administrators": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 8,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 63,
                    "pattern": "^[A-Za-z0-9_@.-]+$"
                  }
                },
                "administrative_memberships": {
                  "type": "array",
                  "maxItems": 8,
                  "uniqueItems": true,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "member": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 63,
                        "pattern": "^[A-Za-z0-9_@.-]+$"
                      },
                      "grantor": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 63,
                        "pattern": "^[A-Za-z0-9_@.-]+$"
                      }
                    },
                    "required": [
                      "member",
                      "grantor"
                    ]
                  }
                },
                "forbidden_databases": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 16,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 63,
                    "pattern": "^[A-Za-z0-9_@.-]+$"
                  }
                },
                "isolated_peer_roles": {
                  "type": "array",
                  "maxItems": 16,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 63,
                    "pattern": "^[A-Za-z0-9_@.-]+$"
                  }
                }
              },
              "required": [
                "migrator",
                "gateway",
                "worker",
                "administrators",
                "administrative_memberships",
                "forbidden_databases",
                "isolated_peer_roles"
              ]
            },
            "clientExistingSecret": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
            },
            "clientCertSecretKey": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^[A-Za-z0-9._-]+$"
            },
            "clientKeySecretKey": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^[A-Za-z0-9._-]+$"
            }
          },
          "required": [],
          "dependencies": {
            "clientExistingSecret": [
              "clientCertSecretKey",
              "clientKeySecretKey"
            ],
            "clientCertSecretKey": [
              "clientExistingSecret",
              "clientKeySecretKey"
            ],
            "clientKeySecretKey": [
              "clientExistingSecret",
              "clientCertSecretKey"
            ]
          }
        },
        "image": {
          "type": "string"
        },
        "instances": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "size": {
