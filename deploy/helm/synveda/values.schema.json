        "resources",
        "nodeSelector",
        "tolerations",
        "affinity",
        "podAnnotations",
        "databaseExistingSecret",
        "databaseUrlSecretKey",
        "databasePasswordSecretKey",
        "dbMaxConnections",
        "shutdownSeconds",
        "logLevel",
        "publicUrl",
        "insecureDevelopmentHttp"
