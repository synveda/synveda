                  "Exists",
                  "Equal"
                ]
              },
              "value": {
                "type": "string"
              },
              "effect": {
                "enum": [
                  "NoSchedule",
                  "PreferNoSchedule",
                  "NoExecute"
                ]
              },
              "tolerationSeconds": {
                "type": "integer"
              }
            },
            "required": []
          }
        },
        "affinity": {
          "type": "object"
        },
        "podAnnotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "enabled",
        "url",
        "image",
        "model",
        "maxBatchTokens",
        "cache",
        "resources",
        "podSecurityContext",
        "nodeSelector",
        "tolerations",
        "affinity",
        "podAnnotations"
