          },
          "required": [
            "size",
            "storageClass"
          ]
        },
        "maxConnections": {
          "type": "integer",
          "minimum": 30,
          "maximum": 10000
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests": {
              "type": "object",
              "additionalProperties": {
                "type": [
                  "string",
                  "number"
                ]
              }
            },
            "limits": {
              "type": "object",
              "additionalProperties": {
                "type": [
                  "string",
                  "number"
                ]
              }
            }
          },
          "required": []
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "retain": {
          "type": "boolean"
        },
        "primaryUpdateStrategy": {
          "enum": [
            "supervised",
            "unsupervised"
          ]
        }
