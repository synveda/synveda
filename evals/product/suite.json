{
  "schema_version": 1,
  "feature": "CPR-40",
  "title": "Context-platform product and trust evaluation",
  "synthetic_product": "PulseBoard",
  "required_measurements": [
    "retrieved",
    "selected",
    "injected",
    "referenced_by_agent",
    "accepted_by_user",
    "helpful",
    "unhelpful",
    "caused_correction"
  ],
  "hard_gates": {
    "cross_tenant_leakage": {
      "maximum": 0,
      "evidence_scenario": "tenant_isolation"
    },
    "private_scope_leakage": {
      "maximum": 0,
      "evidence_scenario": "principal_private_isolation"
    },
    "superseded_current_injection": {
      "maximum": 0,
      "evidence_scenario": "supersession"
    },
    "selected_without_provenance": {
      "maximum": 0,
      "evidence_scenario": "source_trace_completeness"
    },
    "unversioned_skill_or_tool_activation": {
      "maximum": 0,
      "evidence_scenario": "versioned_activation"
    },
    "plaintext_secret_leakage": {
      "maximum": 0,
      "evidence_scenario": "secret_safety"
    }
  },
  "context_optimisation_gates": {
    "critical_fact_loss_maximum": 0,
    "private_source_leak_maximum": 0,
    "obsolete_revision_served_maximum": 0,
    "preview_delivery_maximum": 0,
    "paired_tasks_minimum": 4,
    "compression_case_reduction_minimum_tokens": 1
  },
  "checkpoint_restart_gates": {
    "task_count_minimum": 4,
    "critical_fact_loss_maximum": 0,
    "provenance_failure_maximum": 0,
    "assisted_p95_latency_maximum_ms": 500
  },
