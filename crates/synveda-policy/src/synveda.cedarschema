// The Synveda authorisation model (AUTHZ-1 ADR-0012; AUTHZ-2 ADR-0014;
// AUTHZ-3 ADR-0015; AUTH-3 ADR-0018).
//
// Every pack — embedded or stored — validates against this schema when it
// is compiled, so an ill-typed policy fails at apply/reload time, never at
// decision time. The entity hierarchy mirrors the tenancy hierarchy
// (seed §4.1): scopes chain up to their tenant, and membership checks are
// `in` expressions over that chain — never string comparison, and never
// the materialised path (ADR-0011).
//
// Roles reach decisions as *request context*, never entity attributes
// (ADR-0015 decision 3): `context.roles` is the principal's effective role
// set at the resource, resolved by the PDP and never claimed by a caller.
// Since CPR-6 it carries **both** closed vocabularies — the old hierarchy's
// role bindings (`viewer`, `contributor`, `curator`, `steward`, `org-admin`,
// `auditor`, `security-reviewer`, `compliance`) and the governed scope
// model's grant keys (`owner`, `member`, `viewer`, `reviewer`, `curator`,
// `administrator`) — because the two trees are disjoint and a pack reads one
// `Set<String>`. A grant's keys reach a resource when the grant's scope is on
// that resource's chain, subject to principal privacy (ADR-0073 decision 5).
//
// ABAC context arrived with AUTHZ-5 (ADR-0038) and is one attribute:
// `context.sensitivity` on MemoryRead. Channel stays the pack's
// composition config — one rule, one place (decision 14); residency waits
// for a second region and may turn out to be a composition rule rather
// than a permit (decision 15); time-of-day would be a second clock in a
// product that put expiry in a row (decision 16); and purpose-of-use is
// refused outright as a widening, because a disclosure is initiated on the
// disclosing side (decision 17).
namespace Synveda {
    entity Tenant;

    // A node of the **governed scope tree** (CPR-3, ADR-0070; CPR-6,
    // ADR-0073). Parents follow the tree's parent pointers; the tenant root's
    // parent is the Tenant entity.
    //
    // `kind` is a **shape** — `tenant`, `org_unit`, `workspace`, `project` or
    // `principal` — and it decides only which shapes may parent which. It is
    // not the rank vocabulary this schema used to carry: `org`, `division`,
    // `department`, `team` and `user` are gone, with the strictly-increasing
    // ladder they encoded, and nothing in any pack compares two kinds for
    // order. What survives is the one distinction that is about privacy rather
    // than about seniority: a `principal` scope is somebody's own.
    //
    // `sealed` is AUTH-4's leaver state (ADR-0059 decision 9). It is
    // **required** rather than optional, for the reason `context.grant` and
    // `context.sensitivity` are: the base layer's forbid must never go missing
    // for want of an attribute — a policy referencing a missing one errors,
    // and Cedar drops a policy that errors, which would silently unseal every
    // departed person.
    //
    // It is an attribute of the *resource* where `quarantined` is an attribute
    // of the principal, and the pair is the whole shape of the two controls:
    // quarantine says this caller may do nothing, and a seal says nothing may
    // be done to this material.
    entity Scope in [Tenant, Scope] {
        tenant: Tenant,
        kind: String,
        sealed: Bool,
    };

    // A named set of principals (CPR-5, ADR-0072). Tenant-wide: a group is not
    // anchored anywhere in the scope tree, which is why `GroupManage` applies
    // to the Tenant and nothing else.
    //
    // A principal is parented to every group it is in, so a pack that wants to
    // name one writes `principal in Synveda::Group::"<id>"` — an
    // entity-hierarchy check, never a string comparison against a claim.
    entity Group in [Tenant] {
        tenant: Tenant,
    };

    // The caller: a token subject resolved to a tenant (TEN-1), carrying its
    // provisioning status (AUTH-2, ADR-0013).
    //
    // `own_scope` is the caller's own scope — their `principal`-shaped scope
    // in the governed model, their placement node on the old hierarchy the
    // programme has not deleted yet. The principal entity is parented to it,
    // so `principal in resource` walks the tree upward from it and a pack can
    // *require* placement (an unscoped principal composes nothing — ADR-0014
    // decision 5).
    //
    // `anchors` is the set of scopes this caller actually **holds** something
    // at, direct or through a group (CPR-6, ADR-0073 decision 4). It is the
    // downward direction: `resource in principal.anchors` is "inside something
    // I hold", which is how a workspace grant reaches that workspace's
    // projects with no row written there. Anchors are deliberately **not**
    // parents of the principal — authority flows down from where a grant was
    // written and never up, so a project grant must not make its holder a
    // member of the workspace above it.
    //
    // `ambit` is the **parent** of every scope this caller holds, minus the
    // tenant root — their neighbourhood. It is what `standard`'s sharing
    // default reads, and it is the honest replacement for the `department`
    // attribute that used to serve that rule: a grant at one project shares
    // the workspace it sits in, a grant at one team shares its org unit, and
    // nothing anywhere asks what *kind* of thing that parent is. The tenant
    // root is excluded deliberately — including it would make `standard` mean
    // `open-collaboration`, which is a different pack.
    //
    // `private` is every `principal`-shaped scope this caller may reach: their
    // own, plus any somebody granted them directly. The base layer forbids
    // every other one outright, so this set is the whole of what makes a
    // private scope reachable at all.
    //
    // `department` is **gone**, with the ladder it read. There is no attribute
    // here that names a rung of an organisation.
    //
    // `token_scope` is set for service identities only (AUTH-3, ADR-0018
    // decision 4): the anchor node whose subtree confines the token — the base
    // layer forbids everything outside it, roles notwithstanding.
    entity Principal in [Tenant, Scope, Group] {
        tenant: Tenant,
        quarantined: Bool,
        own_scope?: Scope,
        token_scope?: Scope,
        anchors: Set<Scope>,
        ambit: Set<Scope>,
        private: Set<Scope>,
    };

    // A workspace and the project inside it (CPR-4, ADR-0071), as entities
    // rather than as "the tenant, again" (CPR-6, ADR-0073 decision 3).
    //
    // Each is parented to the governed scope it owns, and a project's scope
    // already sits under its workspace's — so every containment rule written
    // over scopes reaches them without being restated, and `Project in
    // Workspace` is true through the tree rather than through a second edge.
    //
    // They carry `scope` as an attribute as well as as a parent because a pack
    // may want to *name* it (`resource.scope == principal.own_scope`) rather
    // than only test containment.
    entity Workspace in [Tenant, Scope] {
        tenant: Tenant,
        scope: Scope,
    };

    entity Project in [Tenant, Scope] {
        tenant: Tenant,
        scope: Scope,
        workspace: Workspace,
    };

    // One run of an agent (CPR-10, ADR-0076). Parented to the governed scope
    // it runs at — its project's when it has one, its workspace's when it does
    // not — so every containment rule written over scopes reaches it without
    // being restated, and a decision *names the run* rather than the place the
    // run happened at.
    //
    // It carries `scope` as an attribute as well as as a parent for the reason
    // `Workspace` does: a pack may want to name it rather than only test
    // containment.
    //
    // It deliberately carries **no principal**. The ownership distinction a
    // pack might write over one is already expressed by *which scope the
    // session was opened at* — a run at somebody's own `principal` scope is
    // theirs and the base layer's privacy forbid makes it nobody else's — and a
    // second way to say the same thing would be a second answer to one
    // question. ADR-0076 decision 6 records the reversal trigger.
    entity Session in [Tenant, Scope] {
        tenant: Tenant,
        scope: Scope,
    };

    // One grant: a subject's role at a scope (CPR-5, ADR-0072).
    //
    // It is an entity so that revoking *this* grant is a decidable act. Before
    // CPR-6 a revocation named the tenant, so a pack could price "take access
    // away" and never "take away a grant a directory owns" or "take away an
    // owner's". `role` and `source` are strings for the reason `kind` is: a
    // closed vocabulary read by name, with no arithmetic to get wrong.
    entity ScopeGrant in [Tenant, Scope] {
        tenant: Tenant,
        scope: Scope,
        role: String,
        source: String,
    };

    // The scope admin plane (/v1/admin/scopes, CPR-7, ADR-0074 decision 5).
    // Create and update target the scope they are about — the destination
    // for a move, the scope itself for a rename or an archive. There is
    // deliberately **no** delete, for the workspace plane's reason: a scope
    // is what audit events, versions and grants name, so retiring one is a
    // status transition under the update action, and a delete verb would be
    // an authority nobody can exercise.
    action ScopeCreate, ScopeRead, ScopeUpdate
        appliesTo {
            principal: [Principal],
            resource: [Tenant, Scope],
            context: { roles: Set<String> },
        };

    // The workspace and project planes (/v1/workspaces, /v1/projects —
    // CPR-4, ADR-0071 decision 3).
    //
    // Their own actions rather than the hierarchy plane's, and the reason is
    // the audit chain rather than the packs: creating a workspace is not
    // creating a hierarchy node, and an event that said `hierarchy.create`
    // for it would be a lie in the one record this product asks people to
    // trust. A pack that wants to price "make a workspace" differently from
    // "restructure the org" can only say so if they are different actions.
    //
    // Read and create/update are split on the separability rule the rest of
    // this schema uses; there is deliberately **no** delete: a workspace is
    // what sessions, versions and audit events name, so retiring one is a
    // status transition under the update action, and a delete verb would be
    // an authority nobody can exercise.
    //
    // Repository attachments take `ProjectUpdate` and `ProjectRead` rather
    // than a pair of their own. What a project is *about* is part of what the
    // project is — a separate authority over it would be one nobody could
    // describe without describing the project's, and the vocabulary is
    // already the widest thing a reviewer has to hold.
    //
    // Since CPR-6 they apply to the subtype **itself** (ADR-0073 decision 3),
    // which is what ADR-0071 decision 3 said this would become: a read or an
    // update names the workspace or the project, a creation names the scope it
    // would land in (the tenant root for a workspace, the workspace's own
    // scope for a project), and the tenant remains only for the case where a
    // deployment has no root scope yet and there is genuinely nothing more
    // specific to name.
    action WorkspaceRead, WorkspaceCreate, WorkspaceUpdate
        appliesTo {
            principal: [Principal],
            resource: [Tenant, Scope, Workspace],
            context: { roles: Set<String> },
        };

    action ProjectRead, ProjectCreate, ProjectUpdate
        appliesTo {
            principal: [Principal],
            resource: [Tenant, Scope, Workspace, Project],
            context: { roles: Set<String> },
        };

    // The session ledger (/v1/sessions — CPR-10, ADR-0076 decision 6).
    //
    // `SessionRead` covers the session, its events, its context runs and the
    // timeline projected over them. It is **not** `ProjectRead`, and the split
    // is the same one `MembershipRead` makes against `WorkspaceRead`: a
    // project's name discloses nothing, and a session's timeline is a
    // transcript of what somebody and their agent did, said, read and changed.
    // A pack must be able to let a member see the project they work in without
    // handing them everybody's runs.
    //
    // `SessionWrite` covers opening, appending, composing and closing. One
    // authority rather than four, on `ChannelRollback`'s separability rule read
    // the other way: an agent that may open a session must be able to close it,
    // and an authority to open that could not close would produce runs nobody
    // can end.
    //
    // Composing context for a session takes `SessionWrite` **here** and
    // `MemoryRead` at every scope that contributes, decided by the same
    // composition walk `inject` runs — so this action admits no material of its
    // own. It is the authority to *ask*, never the authority to *receive*.
    //
    // There is no delete: a session is what events, candidates, knowledge
    // provenance and audit events name, and disposal belongs to the retention
    // plane.
    //
    // Two resource types and not four. A **listing** is decided at the scope it
    // is anchored at, and each **row** is decided as the session it is about
    // (ADR-0073 decision 3) — so `Workspace` and `Project` never appear here,
    // because a session is not addressed through the subtype that owns its
    // scope. `Tenant` is absent too: a run always happens somewhere, so there
    // is no tenant-wide session question to ask.
    //
    // Keeping the union to two is what lets every pack clause below stay
    // uniform over it: `resource in principal.tenant`, `resource in
    // principal.ambit` and `resource in principal.own_scope` all mean the same
    // thing for a `Session` as for a `Scope`, because a session is parented to
    // the scope it runs at. The one asymmetric rule — the membership floor —
    // is written as two clauses in each pack, and says so.
    action SessionRead, SessionWrite
        appliesTo {
            principal: [Principal],
            resource: [Scope, Session],
            context: { roles: Set<String> },
        };

    // The access plane (/v1/workspaces/{id}/members, /v1/projects/{id}/members,
    // /v1/admin/grants, /v1/admin/groups, /v1/invites — CPR-5, ADR-0072
    // decision 7).
    //
    // Read is one action over the whole plane, on DirectoryManage's argument:
    // "who may act here" and "who has been invited to act here" are the same
    // disclosure seen from two ends, and splitting them would create a role
    // whose only power is reconnaissance over the other half.
    //
    // Read is **not** WorkspaceRead. A workspace's name discloses nothing; its
    // membership discloses who works on what. A pack must be able to let a
    // contributor see the workspace they contribute to without handing them
    // the org chart, and it can only say that if they are two actions.
    //
    // Issuing an invitation takes MembershipGrant rather than an action of its
    // own, because an invitation *is* deferred granting: an authority to invite
    // weaker than the authority to grant would be a way around the second.
    //
    // Since CPR-6 both apply where the membership actually is: the scope, the
    // workspace or the project whose members are being read or changed, and —
    // for a revocation — the **grant itself**, so that a pack can price taking
    // away a directory-managed grant or an owner's differently from taking
    // away an ordinary one (ADR-0073 decision 3). The tenant stays for the
    // tenant-wide listings and for a deployment with no root scope yet.
    action MembershipRead, MembershipGrant
        appliesTo {
            principal: [Principal],
            resource: [Tenant, Scope, Workspace, Project, ScopeGrant],
            context: { roles: Set<String> },
        };

    // Curating groups (/v1/admin/groups). Separate from MembershipGrant on
    // ChannelRollback's separability rule, and the distinction is real: a group
    // says who exists together, a grant says what they may do, and a group with
    // no grant naming it confers nothing at all. A deployment must be able to
    // let somebody maintain the first without conferring the second.
    //
    // Tenant-only: a group is not anchored anywhere in the scope tree — the
    // same shape DirectoryManage has, and for the same reason. A subtree-scoped
    // authority over a tenant-wide set could only ever be a half-truth.
    action GroupManage
        appliesTo {
            principal: [Principal],
            resource: [Tenant, Group],
            context: { roles: Set<String> },
        };

    // Redeeming an invitation (POST /v1/invites/{token}/accept, ADR-0072
    // decision 8).
    //
    // Every shipped pack permits this to any principal the base layer has not
    // already forbidden, and that is the point rather than a gap: the **token**
    // is the authority. A person holding a valid invitation who is refused for
    // want of a role is a person this product invited and then turned away.
    //
    // It exists as an action rather than as an exemption so that the invariant
    // floor still runs over it — a quarantined principal is refused, a sealed
    // scope is refused — and so that a deployment which wants the mechanism off
    // says so in a pack rather than in a deployment flag.
    //
    // Tenant-only, which also means AUTH-3's confinement forbids it to every
    // service identity for free: an agent must not redeem a person's invitation.
    action InviteAccept
        appliesTo {
            principal: [Principal],
            resource: [Tenant],
            context: { roles: Set<String> },
        };

    // The composition seam (AUTHZ-2, ADR-0014 decision 5): may this
    // principal's inject/recall composition include memories attached to
    // this scope? CTX-1/2/3 ask exactly this question per candidate scope.
    //
    // Since AUTHZ-5 it asks per candidate scope *and tier* (ADR-0038
    // decision 1). `sensitivity` is one of `public`, `internal`,
    // `confidential`, `restricted` — a closed, ordered vocabulary, which is
    // precisely why a per-record attribute can be decided here at all: the
    // seam holds no record, but it can be asked about each of four tiers
    // before any record is fetched. A pack names the tiers it permits
    // (`["public", "internal"].contains(context.sensitivity)`) rather than
    // comparing an encoding, because with four values the enumeration is the
    // documentation and there is no arithmetic to get wrong.
    //
    // `lapsed` is required — not optional — because a policy that
    // referenced a missing attribute would error,
    // Cedar would drop it, and the base layer's lapse permit would silently
    // stop existing. The PDP sets it on every MemoryRead request, true only
    // when a standing grant covers exactly this (principal, action, scope)
    // **at or above this tier** *and* the pack in force at that scope still
    // admits lapses at all (AUTHZ-4, ADR-0037 decisions 5 and 9; AUTHZ-5,
    // ADR-0038 decision 6). `sensitivity` is required for the same reason:
    // the base layer's `restricted` forbid must never go missing for want of
    // an attribute.
    //
    // They are deliberately the only action's attributes. A lapse relaxes a
    // closed vocabulary (synveda_types::LapseAction), and an attribute that
    // existed on every action would be an invitation to widen that
    // vocabulary in a pack rather than in a reviewed diff.
    action MemoryRead
        appliesTo {
            principal: [Principal],
            resource: [Scope],
            context: { roles: Set<String>, lapsed: Bool, sensitivity: String },
        };

    // Reclassification (AUTHZ-5, ADR-0038 decision 9): may this principal
    // run a classification proposal's effect at this scope — moving records
    // to the sensitivity their proposed versions carry?
    //
    // Its own action rather than MemoryWrite, on ChannelRollback's
    // separability rule: the write floor grants every principal MemoryWrite
    // at its own home, and a pack must be able to say "you may write here"
    // without saying "you may classify here".
    //
    // It carries no sensitivity attribute, and that is not an oversight: how
    // much authority a reclassification needs is the approval matrix's
    // arithmetic, resolved at the maximum of the current and proposed tiers,
    // and duplicating that as a Cedar condition would put the rule in two
    // places that can disagree.
    action MemoryClassify
        appliesTo {
            principal: [Principal],
            resource: [Scope],
            context: { roles: Set<String> },
        };

    // The write seam (MEM-1, ADR-0020 decision 3): may this principal
    // land memory content at this scope? observe asks it for the
    // caller's personal scope; richer write surfaces (FLOW) will ask the
    // same question at shared scopes.
    action MemoryWrite
        appliesTo {
            principal: [Principal],
            resource: [Scope],
            context: { roles: Set<String> },
        };

    // The prompt registry (/v1/prompts, PRMT-1, ADR-0049 decision 4): may
    // this principal be served a prompt attached to this scope, and may it
    // author one there?
    //
    // `PromptRead` carries `sensitivity` for MemoryRead's reason: with four
    // values the seam can be asked about a tier before any content is
    // fetched, so a pack prices a `confidential` prompt exactly as it prices
    // confidential memory. It deliberately carries **no** `lapsed`: the
    // lapse vocabulary is closed over `memory.read` (ADR-0037 decision 2)
    // and widening it is a lapse feature's decision, taken in two reviewed
    // places, not a side effect of adding an asset type. And no pack names
    // `restricted` here, because nothing in the product can mint that tier
    // for an authored asset — migration 0029's CHECK is where that is
    // structural (ADR-0049 decision 5).
    //
    // `PromptWrite` is the authoring seam and mirrors `MemoryWrite`: the
    // home floor role-free, bound content roles beyond it. Separate from
    // `MemoryWrite` on `ChannelRollback`'s separability rule — every placed
    // principal holds the memory write floor at its own home, and a pack
    // must be able to say "observe here" without saying "author governed
    // assets here".
    //
    // Both are scope actions, never tenant-level: a prompt belongs to a
    // node, so AUTH-3's confinement covers agents for free.
    action PromptRead
        appliesTo {
            principal: [Principal],
            resource: [Scope],
            context: { roles: Set<String>, sensitivity: String },
        };

    action PromptWrite
        appliesTo {
            principal: [Principal],
            resource: [Scope],
            context: { roles: Set<String> },
        };

    // The context-pack registry (/v1/context-packs, PRMT-2, ADR-0050
    // decision 7): may this principal be served a pack attached to this
    // scope, and may it author one there?
    //
    // The prompt plane's shape, tier for tier, and for its reasons — with
    // one difference that is the whole of ADR-0050 decision 8:
    // `ContextPackRead` is taken per scope inside the *composition* plan
    // walk, so it is the action that admits pack chunks into a block.
    // `MemoryRead` never admits one and this never admits a memory, which
    // is what lets a scope distribute conventions to readers holding no
    // readable memory there.
    //
    // No pack names `restricted` here either — migration 0030's CHECK is
    // where that is structural (ADR-0050 decision 12).
    action ContextPackRead
        appliesTo {
            principal: [Principal],
            resource: [Scope],
            context: { roles: Set<String>, sensitivity: String },
        };

    action ContextPackWrite
        appliesTo {
            principal: [Principal],
            resource: [Scope],
            context: { roles: Set<String> },
        };

    // The skills registry (/v1/skills, SKIL-1, ADR-0051 decision 10): may
    // this principal be served a skill bundle attached to this scope, and
    // may it author one there?
    //
    // `PromptRead`'s shape and none of `ContextPackRead`'s: a skill is
    // fetched by name and materialised into a client's own skills
    // directory, never ranked into a composed block (decision 9), so this
    // action is taken on its own route and appears nowhere in the
    // composition plan walk. The client's own progressive disclosure is the
    // loader; a block would be doing that job twice and worse.
    //
    // `SkillWrite` is separate from `ContextPackWrite` on the separability
    // rule, and here the reason is sharpest: a skill is executable, so a
    // pack must be able to say "curate conventions here" without saying
    // "author code here".
    //
    // No pack names `restricted` here either — migration 0031's CHECK is
    // where that is structural (ADR-0051 decision 11).
    action SkillRead
        appliesTo {
            principal: [Principal],
            resource: [Scope],
            context: { roles: Set<String>, sensitivity: String },
        };

    action SkillWrite
        appliesTo {
            principal: [Principal],
            resource: [Scope],
            context: { roles: Set<String> },
        };

    // Publishing a bundle the quality gate would refuse (SKIL-3, ADR-0053
    // decision 8): a *second* decision at the publish seam, beside the
    // ChannelPublish the publication already takes.
    //
    // The separation is the whole content of the action — a publisher who
    // may ship a good skill cannot necessarily ship one below the bar, and
    // has to go and find somebody who can. ADR-0051 decision 18's argument
    // in its own idiom: the content of separating two authorities is that
    // they can be two people.
    //
    // No `sensitivity` in the context, unlike SkillRead: this is a
    // statement about a *process* rather than about content, so a tier
    // would be a field with nothing to say.
    //
    // There is deliberately no equivalent for the security scan and there
    // must not be one. ADR-0052 decision 3 put `critical` on the invariant
    // floor precisely so that no pack and no role can wave it through; an
    // override that reached it would make that guarantee negotiable by
    // whoever holds this action.
    action SkillQualityOverride
        appliesTo {
            principal: [Principal],
            resource: [Scope],
            context: { roles: Set<String> },
        };

    // The policy admin plane (/v1/policy/*, ADR-0014 decision 8): reading
    // packs and effective assignments, and assigning packs to nodes (or
    // the tenant default — the Tenant resource).
    action PolicyRead, PolicyAssign
        appliesTo {
            principal: [Principal],
            resource: [Tenant, Scope],
            context: { roles: Set<String> },
        };

    // (The role admin plane — `RoleRead`/`RoleAssign` over role bindings,
    // ADR-0015 decision 7 — is deleted with the bindings: grants are the
    // access plane's actions, a revocation names the grant it is about, and
    // the escalation guard that needed `context.grant` went with the verb it
    // guarded. CPR-7, ADR-0074.)

    // The quarantine review plane (/v1/quarantine, MEM-2, ADR-0021
    // decision 6): listing pending quarantined observe events and
    // reviewing one (release/reject).
    //
    // **Both decide at the tenant since CPR-7** (ADR-0074 decision 7).
    // Every quarantined event now lands at a `principal`-shaped scope,
    // and a principal scope inherits nothing — so a verdict anchored at
    // the event's own scope was reachable by nobody but the person whose
    // secret it was. `Scope` stays in the vocabulary because a queue may
    // still be *filtered* to a subtree, and because a stored pack is free
    // to write a narrower rule; the product routes ask at the tenant.
    action QuarantineRead
        appliesTo {
            principal: [Principal],
            resource: [Tenant, Scope],
            context: { roles: Set<String> },
        };

    action QuarantineReview
        appliesTo {
            principal: [Principal],
            resource: [Tenant, Scope],
            context: { roles: Set<String> },
        };

    // The service-identity plane (/v1/service-identities, AUTH-3,
    // ADR-0018 decision 3): reading registrations (get on the anchor;
    // list on the tenant resource) and registering/revoking agents at an
    // anchor scope. Manage deliberately never applies to the tenant:
    // an agent is always anchored at a node.
    action ServiceIdentityRead
        appliesTo {
            principal: [Principal],
            resource: [Tenant, Scope],
            context: { roles: Set<String> },
        };

    action ServiceIdentityManage
        appliesTo {
            principal: [Principal],
            resource: [Scope],
            context: { roles: Set<String> },
        };

    // The directory plane (/v1/scim/credentials, AUTH-4, ADR-0059
    // decision 13): issuing, listing and revoking the static credential a
    // provisioning agent authenticates with.
    //
    // **Tenant only**, like AuditRead and for a related reason: a
    // provisioning credential is not anchored anywhere — it can create,
    // move and seal identities anywhere in the tenancy — so a subtree-scoped
    // authority over one could only ever be a half-truth. Leaving `Scope`
    // out of `appliesTo` makes that unrepresentable rather than relying on
    // a handler to remember, and the base layer's token-scope confinement
    // therefore covers service identities for free: the tenant plane is
    // never inside a scope subtree, so no agent can mint a directory
    // credential however it is bound.
    //
    // One action for reading the inventory *and* mutating it, unlike the
    // service-identity plane's pair. The inventory is a list of live keys
    // to the directory plane, and there is nobody who should be able to see
    // which credentials exist without also being able to rotate them —
    // splitting it would create a role whose only power is reconnaissance.
    action DirectoryManage
        appliesTo {
            principal: [Principal],
            resource: [Tenant],
            context: { roles: Set<String> },
        };

    // The pull sync's circuit breaker, and the human who releases it
    // (AUTH-5, ADR-0060 decision 10). Separate from DirectoryManage
    // because the magnitudes are not comparable: one hands out a
    // provisioning token, this one authorises irreversible bulk sealing of
    // personal scopes that do not unseal. A customer who wants those two
    // held by two people can only say so if they are two actions.
    //
    // Seeing the refusal and signing for it are one action, unlike the
    // service-identity plane's pair: a signer who cannot see the number
    // they are bounding is signing blind, which is what the ceiling exists
    // to prevent.
    action DirectorySealAuthorise
        appliesTo {
            principal: [Principal],
            resource: [Tenant],
            context: { roles: Set<String> },
        };

    // The audit query plane (/v1/audit/*, AUD-2, ADR-0045 decision 1):
    // searching the chain, the two questions the feature exists for, and
    // the chain check itself. One action, not four — verification returns a
    // verdict and a sequence number and no event content, so a principal
    // who may read the chain may check it.
    //
    // **Tenant only, and that is the enforcement rather than a route
    // check.** There is one chain per tenant, and an event's `resource` is
    // a scope for some actions and a binding, a tenant or nothing for
    // others — so a subtree-scoped audit answer could only ever be "the
    // events we could attribute to your subtree", which silently omits the
    // ones it could not parse. Leaving `Scope` out of `appliesTo` makes
    // that answer unrepresentable: a scope-resource audit request fails
    // schema validation and denies, rather than relying on every future
    // handler to remember (ADR-0045 decision 2).
    //
    // The base layer's token-scope confinement therefore covers agents for
    // free: the tenant plane is never inside a scope subtree, so no service
    // identity can read the trail however it is bound (ADR-0018
    // decision 4).
    action AuditRead
        appliesTo {
            principal: [Principal],
            resource: [Tenant],
            context: { roles: Set<String> },
        };

    // The VedaFlow channel plane (/v1/channels/*, FLOW-2, ADR-0031
    // decision 12): reading a scope's channels, and publishing records
    // onto its published channel — the act that moves content across the
    // trust boundary. Never a tenant-level action: a channel belongs to a
    // node. FLOW-3 puts required approvals in front of ChannelPublish; it
    // does not replace it.
    action ChannelRead, ChannelPublish
        appliesTo {
            principal: [Principal],
            resource: [Scope],
            context: { roles: Set<String> },
        };

    // The other two ways a channel moves (FLOW-7, ADR-0036 decision 3).
    //
    // ChannelRollback rewinds a scope's published channel to a state it has
    // already held; ChannelPin holds what that channel *serves* at a commit,
    // and releases the hold. Separate from ChannelPublish so a pack can say
    // "publish widely, rewind narrowly" — one action would make that
    // sentence unsayable forever.
    //
    // Neither resolves an approval matrix, and that is safe for one reason
    // only: a rewind can install nothing that was not already approved when
    // it was installed. Both are scope actions, never tenant-level, like the
    // rest of the channel plane.
    action ChannelRollback, ChannelPin
        appliesTo {
            principal: [Principal],
            resource: [Scope],
            context: { roles: Set<String> },
        };

    // The VedaFlow proposal plane (/v1/proposals/*, FLOW-3, ADR-0032
    // decision 16): reading proposals, opening one against a scope, and
    // casting a review verdict on one.
    //
    // These decide who may act, never how many acts are needed. "Have
    // enough of the right people approved" is a count over stored
    // approvals that the PDP cannot see and must not be given storage to
    // see (seed §2.4); that arithmetic lives in the approval matrix the
    // pack carries beside its policies.
    //
    // ProposalRead applies to the Tenant as well as a Scope: the review
    // inbox (FLOW-6's `proposal list`, CNSL-1's hero screen) is a
    // tenant-wide read, and the packs grant that to review and admin
    // roles only — the per-scope membership floor deliberately does not
    // reach it.
    action ProposalRead
        appliesTo {
            principal: [Principal],
            resource: [Tenant, Scope],
            context: { roles: Set<String> },
        };

    // Opening and reviewing are always acts against a node — the target
    // scope whose channel would move — never against the tenant.
    action ProposalOpen, ProposalReview
        appliesTo {
            principal: [Principal],
            resource: [Scope],
            context: { roles: Set<String> },
        };

    // The lapse plane (AUTHZ-4, ADR-0037 decision 15).
    //
    // LapseGrant runs an approved lapse proposal's effect: it opens a
    // time-boxed, reasoned grant of one action from one scope to another.
    // LapseRevoke ends a standing grant early.
    //
    // Two actions rather than one, on ChannelRollback's precedent and for
    // its reason: a pack must be able to grant one broadly and the other
    // narrowly, because the responder who should be able to end a lapse at
    // 3am is not the steward who should be able to open one. Revoking
    // resolves no matrix — it installs nothing and can only narrow.
    //
    // The resource of both is the **target** scope, the one whose material
    // is disclosed. Authority over a disclosure belongs where the material
    // is, never where the request came from. Never tenant-level: a lapse is
    // always about one node's material.
    //
    // Neither is PolicyAssign, which is the obvious reuse and the wrong one:
    // PolicyAssign is the single action decided with the resource's own
    // assignment skipped (ADR-0014 decision 4), so a lapse would be
    // authorized under the node's *parent's* pack while its approval matrix
    // resolved under the node's own.
    action LapseGrant, LapseRevoke
        appliesTo {
            principal: [Principal],
            resource: [Scope],
            context: { roles: Set<String> },
        };
}
