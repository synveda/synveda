  "query": "select seq, occurred_at, actor_kind, actor_subject, action, payload\n           from audit_log\n           where tenant_id = $1\n             and action = 'session.context.composed'\n             and actor_subject = $2\n             and occurred_at <= $3\n             and seq < $4\n           order by seq desc\n           limit $5",
