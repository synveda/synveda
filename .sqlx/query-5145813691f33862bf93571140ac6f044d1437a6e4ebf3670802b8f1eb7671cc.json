{
  "db_name": "PostgreSQL",
  "query": "select seq, occurred_at, actor_kind, actor_subject, action, payload\n           from audit_log\n           where tenant_id = $1\n             and action in ('context.injected', 'context.recalled')\n             and payload @> $2::jsonb\n             and seq > $3\n             and occurred_at >= $4\n             and occurred_at < $5\n           order by seq\n           limit $6",
