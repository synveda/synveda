{
  "db_name": "PostgreSQL",
  "query": "\n        select n.id, n.tenant_id, n.parent_id, n.kind, n.slug, n.name,\n               n.depth, n.path, n.created_at\n        from hierarchy_closure c\n        join hierarchy_nodes n on n.id = c.ancestor_id\n        where c.descendant_id = $1 and c.tenant_id = $2\n        order by c.distance\n        ",
