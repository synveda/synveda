  "query": "\n        insert into policy_pack_assignments (tenant_id, scope_id, pack_name)\n        values ($1, $2, $3)\n        on conflict (tenant_id, scope_id) do update\n            set pack_name = excluded.pack_name,\n                updated_at = now()\n        returning tenant_id, scope_id, pack_name, updated_at\n        ",
