{
  "db_name": "PostgreSQL",
  "query": "\n        select n.id, n.tenant_id, n.parent_id, n.kind, n.slug, n.name,\n               n.depth, n.path, n.created_at\n        from hierarchy_closure c\n        join hierarchy_nodes n on n.id = c.descendant_id\n        where c.ancestor_id = $1 and c.distance > 0\n        order by n.path\n        ",
