  "query": "select address.artifact_id,address.job_id,address.project_id,address.scope_id,address.workspace_id,address.content_hash,address.source_key_digest\n      from artifact_cleanup_targets target join source_artifact_addresses address on address.tenant_id=target.tenant_id and address.artifact_id=target.artifact_id\n      where target.tenant_id=$1 and target.operation_id=$2",
