  "query": "\n        select meter, usage_day, units\n          from tenant_usage\n         where tenant_id = $1\n           and meter in ('session_event_bytes', 'context_runs')\n           and usage_day > $2::date - $3::int\n         order by usage_day desc, meter\n         limit $4\n        ",
