  "query": "\n        insert into policy_packs (tenant_id, name, version, source)\n        values ($1, $2, 1, $3)\n        on conflict (tenant_id, name) do update\n            set source = excluded.source,\n                version = policy_packs.version + 1,\n                updated_at = now()\n        returning tenant_id, name, version, source, updated_at\n        ",
