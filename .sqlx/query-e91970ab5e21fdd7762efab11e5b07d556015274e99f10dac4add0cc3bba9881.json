  "db_name": "PostgreSQL",
  "query": "\n        select i.id, i.tenant_id, i.subject, i.kind, i.email, i.display_name,\n               i.scope_id, i.status, i.departed_at, i.created_at\n        from identities i\n        where i.tenant_id = $1 and lower(i.email) = lower($2)\n        order by i.created_at\n        limit 1\n        ",
