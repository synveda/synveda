  "components": {
    "schemas": {
      "ApiErrorBody": {
        "type": "object",
        "description": "The taxonomy error body, declared for the OpenAPI document.\n\nA schema-only mirror of `synveda_types::Error`'s serialised form, which is\n`{\"kind\": \"...\", ...}` with a per-variant remainder. It exists because the\ncontract has to say what a 4xx body looks like and the taxonomy lives two\ncrates down, where `utoipa` deliberately does not reach — the OpenAPI\nderive is a property of the surface, and `synveda-types` is not one.",
        "required": [
          "kind"
        ],
        "properties": {
          "action": {
            "type": [
              "string",
              "null"
            ],
            "description": "`policy_denied` only: the action that was attempted."
          },
          "entity": {
            "type": [
              "string",
              "null"
            ],
            "description": "`not_found` only: what was looked up."
          },
          "kind": {
            "type": "string",
            "description": "The stable machine-readable code — `invalid`, `conflict`, `not_found`,\n`policy_denied`, …"
          },
          "message": {
            "type": [
              "string",
              "null"
            ],
            "description": "Present on most variants; what went wrong, safe to show a caller."
          },
          "reason": {
            "type": [
              "string",
              "null"
            ],
            "description": "`policy_denied` only: which policy produced the denial."
          },
          "resource": {
            "type": [
              "string",
              "null"
            ],
            "description": "`policy_denied` only: what was acted on."
          }
        }
      },
      "AttachRepositoryBody": {
        "type": "object",
        "description": "`POST /v1/projects/{project_id}/repositories`.\n\nThe server derives `provider`, `canonical_uri`, `repository_owner` and\n`repository_name`; a client sends what it knows and never what it\nconcluded, because two clients concluding separately is how one repository\nbecomes two rows.",
        "properties": {
          "default_branch": {
            "type": [
              "string",
              "null"
            ],
            "description": "Advisory default branch. Nothing in the product resolves it."
          },
          "local_fingerprint": {
            "type": [
              "string",
              "null"
            ],
            "description": "A stable content id for a repository with no remote — a git\nroot-commit object id, 40–128 hex characters. Never a path."
          },
          "metadata": {
            "type": [
              "object",
              "null"
            ],
            "description": "Caller-supplied labelling bag; a JSON object, at most 8 KiB encoded."
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "description": "What to call it. Derived from the remote when there is one; **required**\nwhen there is not, because a fingerprint names nothing a human reads."
          },
          "provider": {
            "type": "string",
            "enum": [
              "github",
              "gitlab",
              "bitbucket",
              "azure_devops",
              "generic_git",
              "local"
            ]
          },
          "remote_uri": {
            "type": [
              "string",
              "null"
            ],
            "description": "The remote, in any form git accepts: `https://host/owner/name`,\n`git@host:owner/name.git`, `ssh://git@host/owner/name`. **The\nidentity**, whenever it is known. A filesystem path is refused."
          }
        },
        "additionalProperties": false
      },
      "CreateProjectBody": {
        "type": "object",
        "description": "`POST /v1/workspaces/{workspace_id}/projects`.",
        "required": [
          "slug",
          "display_name"
        ],
        "properties": {
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional prose."
          },
          "display_name": {
            "type": "string",
            "description": "Display name."
          },
          "slug": {
            "type": "string",
            "description": "Workspace-unique handle, same grammar as a workspace slug."
          }
        },
        "additionalProperties": false
      },
      "CreateWorkspaceBody": {
        "type": "object",
        "description": "`POST /v1/workspaces`.",
        "required": [
          "slug",
          "display_name"
        ],
        "properties": {
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional prose. Blank is refused; omit it instead."
          },
          "display_name": {
            "type": "string",
            "description": "Display name."
          },
          "slug": {
            "type": "string",
            "description": "Tenant-unique handle: `^[a-z0-9][a-z0-9-]{0,62}$`. Becomes the owned\nscope's slug too, and is immutable afterwards."
          }
        },
        "additionalProperties": false
      },
      "MeView": {
        "type": "object",
        "description": "Everything a client needs before it renders anything.",
        "required": [
          "principal",
          "tenant",
          "onboarding",
          "workspaces",
          "projects",
          "capabilities"
        ],
        "properties": {
          "capabilities": {
            "$ref": "#/components/schemas/TenantCapabilities",
            "description": "What this caller may do on the tenant plane, asked of the PDP.\n\n**A forecast, never a grant** (ADR-0058 decision 2): nothing downstream\nreads this to decide anything, every act still takes its own decision\nat its own seam, and a client uses this to choose what to *offer*."
          },
          "onboarding": {
            "$ref": "#/components/schemas/OnboardingView",
            "description": "Where they are in setting up — the server's answer, not a client's\ninference from an empty list."
          },
          "principal": {
            "$ref": "#/components/schemas/PrincipalView",
            "description": "Who is calling."
          },
          "projects": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProjectView"
            },
            "description": "Every project this caller may read, by workspace then slug. Flat rather\nthan nested under its workspace: a client that wants the tree has\n`workspace_id` on every row, and one that wants a recent-projects list\nwould otherwise have to flatten what we just nested."
          },
          "tenant": {
            "$ref": "#/components/schemas/TenantView",
            "description": "The tenant they resolved to."
          },
          "workspaces": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WorkspaceView"
            },
            "description": "Every workspace this caller may read, by slug."
          }
        }
      },
      "OnboardingState": {
        "type": "string",
        "description": "The onboarding vocabulary. Closed, so a client's branch is exhaustive and\na new state is a compile error somewhere rather than a silently unhandled\nstring.",
        "enum": [
          "blocked",
          "needs_workspace",
          "needs_project",
          "ready"
        ]
      },
      "OnboardingView": {
        "type": "object",
        "description": "How far along setting up this caller is.",
        "required": [
          "state",
          "workspace_count",
          "project_count"
        ],
        "properties": {
          "project_count": {
            "type": "integer",
            "description": "How many projects this caller can see.",
            "minimum": 0
          },
          "state": {
            "$ref": "#/components/schemas/OnboardingState",
            "description": "The single word a client branches on."
          },
          "tenant_scope_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "The tenant's root scope, once anything has needed one. Absent on a\ndeployment where nobody has created a workspace yet: the root is minted\nby the first thing that needs a parent, so that nobody is asked to\ndeclare an organisation before they can hold a record."
          },
          "workspace_count": {
            "type": "integer",
            "description": "How many workspaces this caller can see.",
            "minimum": 0
          }
        }
      },
      "PrincipalView": {
        "type": "object",
        "description": "The authenticated principal.",
        "required": [
          "subject",
          "quarantined"
        ],
        "properties": {
          "display_name": {
            "type": [
              "string",
              "null"
            ],
            "description": "The IdP's `name` claim at provisioning time, if any."
          },
          "identity_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "The identity row, when this subject has provisioned one. Absent for a\ndev token and for a service client that never completed login."
          },
          "kind": {
            "type": [
              "string",
              "null"
            ],
            "description": "`human` or `service`."
          },
          "quarantined": {
            "type": "boolean",
            "description": "Whether the base layer forbids this caller everything (AUTH-2,\nADR-0013 decision 5). True also for an IdP subject that never\nprovisioned — fail closed."
          },
          "subject": {
            "type": "string",
            "description": "The verified token's `sub` claim — the name every audit event, role\nbinding and idempotency key is keyed by."
          }
        }
      },
      "ProjectList": {
        "type": "object",
        "description": "The project listing.",
        "required": [
          "projects"
        ],
        "properties": {
          "projects": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProjectView"
            },
            "description": "The workspace's projects, by slug. Archived ones included."
          }
        }
      },
      "ProjectView": {
        "type": "object",
        "description": "A project, as the API serves it.",
