            "description": "Who created it; absent when the deployment did."
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional prose."
          },
          "display_name": {
            "type": "string",
            "description": "Display name."
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "The workspace's stable id."
          },
          "revision": {
            "type": "integer",
            "format": "int64",
            "description": "The revision an update must name as its precondition."
          },
          "scope_id": {
            "type": "string",
            "format": "uuid",
            "description": "The governed scope this workspace owns — what policy, role bindings and\nevery asset attach to."
          },
          "slug": {
            "type": "string",
            "description": "Tenant-unique handle, identical to the scope's slug. Immutable."
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "archived"
            ]
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "When it last changed."
          }
        }
      }
