              "github",
              "gitlab",
              "bitbucket",
              "azure_devops",
              "generic_git",
              "local"
            ]
          },
          "repository_name": {
            "type": "string",
            "description": "The repository's own name."
          },
          "repository_owner": {
            "type": [
              "string",
              "null"
            ],
            "description": "The owning path on the host, when the remote had one."
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "When it last changed."
          }
        }
      },
      "TenantCapabilities": {
        "type": "object",
        "description": "What the caller may do on the **tenant** plane — `whoami`'s block, and\nsince CPR-4 `/v1/me`'s.\n\nCarries a `ToSchema` because `/v1/me` embeds it and that route is on the\nOpenAPI contract. The three fields are declared to the document by\n`value_type` rather than derived: `Role` and the `&'static str` map keys\nlive in `synveda-types`, where `utoipa` deliberately does not reach — a\ncontract is a property of the surface, and no crate below the gateway has\none.",
        "required": [
          "roles",
          "actions",
          "role_assign"
        ],
        "properties": {
          "actions": {
            "type": "object",
            "description": "Every operand-free tenant-plane action, by its stable machine name.",
            "additionalProperties": {
              "type": "boolean"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "role_assign": {
            "type": "object",
            "description": "`RoleAssign` per role, because it fails closed without\n`context.grant`.",
            "additionalProperties": {
              "type": "boolean"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The caller's tenant-wide effective roles. Node bindings are absent\nby construction: [`effective_roles_at`] keeps only the tenant-wide\nrows for a tenant resource, which is the same rule the decisions\nbeside it ran under."
          }
        }
      },
      "TenantView": {
        "type": "object",
        "description": "The tenant, as this plane serves it.",
        "required": [
          "id",
          "slug",
          "name",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "The isolation key."
          },
          "name": {
            "type": "string",
            "description": "Display name."
          },
          "slug": {
            "type": "string",
            "description": "Human-stable handle."
          },
          "status": {
            "type": "string",
            "description": "`active` or `suspended`."
          }
        }
      },
      "UpdateBody": {
        "type": "object",
        "description": "`PATCH /v1/workspaces/{workspace_id}` and\n`PATCH /v1/projects/{project_id}`.\n\n`description` has three cases and the wire says them apart: absent leaves\nit alone, `null` clears it, a string replaces it.",
        "required": [
          "expected_revision"
        ],
        "properties": {
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "New description; `null` clears it."
          },
          "display_name": {
            "type": [
              "string",
              "null"
            ],
            "description": "New display name."
          },
          "expected_revision": {
            "type": "integer",
            "format": "int64",
            "description": "The revision the caller last saw. Required: an update without a\nprecondition is a last-writer-wins update, which is the failure this\nfield exists to remove rather than a convenience it offers."
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "archived"
            ]
          }
        },
        "additionalProperties": false
      },
      "WorkspaceList": {
