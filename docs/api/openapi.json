      "RepositoryView": {
        "type": "object",
        "description": "A repository attached to a project, as the API serves it.",
        "required": [
          "id",
          "project_id",
          "provider",
          "canonical_uri",
          "repository_name",
          "metadata",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "canonical_uri": {
            "type": "string",
            "description": "**The identity**: canonical, credential-free, and never a filesystem\npath. Two clients that describe one repository differently are served\nthe same value here, which is what makes it an identity."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "When it was attached."
          },
          "created_by": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "Who attached it."
          },
          "default_branch": {
            "type": [
              "string",
              "null"
            ],
            "description": "The advisory default branch."
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "The attachment's id — the handle `DELETE` takes."
          },
          "local_fingerprint": {
            "type": [
              "string",
              "null"
            ],
            "description": "The stable content fingerprint of a local checkout, when one was given."
          },
          "metadata": {
            "type": "object",
            "description": "The caller's labelling bag, echoed back."
          },
          "project_id": {
            "type": "string",
            "format": "uuid",
            "description": "The project it belongs to."
          },
          "provider": {
            "type": "string",
