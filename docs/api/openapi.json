              "null"
            ],
            "format": "uuid",
            "description": "Who created it."
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional prose."
          },
          "display_name": {
            "type": "string",
            "description": "Display name."
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "The project's stable id."
          },
          "revision": {
            "type": "integer",
            "format": "int64",
            "description": "The revision an update must name as its precondition."
          },
          "scope_id": {
            "type": "string",
            "format": "uuid",
            "description": "The governed scope this project owns, beneath the workspace's."
          },
          "slug": {
            "type": "string",
            "description": "Workspace-unique handle, identical to the scope's slug. Immutable."
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "archived"
            ]
          },
          "updated_at": {
            "type": "string",
